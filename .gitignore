# Project exclude paths
/.gradle/
/app/build/
/build/
/local.properties
/.kotlin/

# macOS
.DS_Store

# Memory Dumps
*.hprof

# Signing (never commit a real release keystore or its credentials)
*.jks
*.keystore
keystore.properties

# Firebase — this device-side config is per-operator (your own Firebase project). Drop your
# downloaded app/google-services.json in place; FCM stays inactive until you do (see
# app/build.gradle.kts's conditional google-services apply and PUSH_ANDROID_SETUP.md).
/app/google-services.json

# Local Claude Code session state — not part of the app
/.claude/

# Self-hosted gift faucet backend — runs only on the operator's machine, holds the hot-wallet
# private key and Play Integrity secrets. MUST never be committed/published.
/gift-server/
