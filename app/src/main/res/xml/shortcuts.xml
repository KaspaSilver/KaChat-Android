<?xml version="1.0" encoding="utf-8"?>
<!-- Sharing Shortcuts (direct share): declares MainActivity as the receiver for shortcuts
     published with the SHARE_TARGET category (see ShareShortcutsManager). The system share
     sheet combines this static declaration with the dynamic conversation shortcuts to show
     recent chats as one-tap direct-share targets. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.kachat.app.MainActivity">
        <data android:mimeType="text/plain" />
        <category android:name="com.kachat.app.category.SHARE_TARGET" />
    </share-target>
    <share-target android:targetClass="com.kachat.app.MainActivity">
        <data android:mimeType="image/*" />
        <category android:name="com.kachat.app.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
