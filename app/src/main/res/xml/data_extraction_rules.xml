<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing moves with a phone transfer or a cloud backup. The encrypted stores' keys stay in the old
     phone's Keystore, so a copied store can't be read, and accounts come back from their words. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
